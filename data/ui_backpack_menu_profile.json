    },
    "close": {
      "durationMs": 190,
      "steps": [
        "collapse_detail_panel",
        "drop_or_fold_backpack_shell",
        "fade_out_shadow_wash",
        "restore_gameplay_hud_opacity"
      ],
      "easing": "cubic_in"
    },
    "selection": {
      "pulseDurationMs": 950,
      "jitterPx": 2,
      "iconNudgePx": 1.5,
      "style": "subtle_hand_drawn_wobble"
    },
    "lostItems": {
      "pageFlipDurationMs": 220,
      "strikeThroughDurationMs": 160,
      "idlePaperSwayPx": 1.5
    },
    "reducedMotion": {
      "panelOpenMs": 0,
      "panelCloseMs": 0,
      "selectionPulse": false,
      "pageFlip": false,
      "idleSway": false
    }
  },
