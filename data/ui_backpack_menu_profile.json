      "inventoryColumnsPhoneLandscape": 4,
      "detailsPanelDesktop": "right",
      "detailsPanelPhoneLandscape": "below_or_right_if_space"
    }
  },
  "animation": {
    "open": {
      "durationMs": 280,
      "steps": [
        "fade_gameplay_hud_to_55_percent",
        "fade_in_cold_shadow_wash",
